[Unit]
Description=UsinaUFVMaravilhaSite - monitoramento em tempo real (ASP.NET Core)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/usinaufvmaravilhasite
ExecStart=/usr/bin/dotnet /var/www/usinaufvmaravilhasite/UsinaUFVMaravilhaSite.dll
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=usinaufvmaravilhasite
User=usinaufvmaravilhasite
Group=usinaufvmaravilhasite
EnvironmentFile=/etc/usinaufvmaravilhasite/usinaufvmaravilhasite.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://localhost:5001

[Install]
WantedBy=multi-user.target
