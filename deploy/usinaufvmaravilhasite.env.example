# Copie este arquivo para /etc/usinaufvmaravilhasite/usinaufvmaravilhasite.env no servidor e ajuste:
#   sudo mkdir -p /etc/usinaufvmaravilhasite
#   sudo cp deploy/usinaufvmaravilhasite.env.example /etc/usinaufvmaravilhasite/usinaufvmaravilhasite.env
#   sudo chmod 600 /etc/usinaufvmaravilhasite/usinaufvmaravilhasite.env
#   sudo chown usinaufvmaravilhasite:usinaufvmaravilhasite /etc/usinaufvmaravilhasite/usinaufvmaravilhasite.env
#
# NUNCA commitar o arquivo real (.env) — apenas este .example, sem o IP/dados reais do CLP.
# A seção "Plant" do appsettings.json é lida a partir de variáveis de ambiente
# Plant__Host, Plant__Port etc. (":" vira "__" em variáveis de ambiente).
#
# IMPORTANTE: o parser de EnvironmentFile do systemd trata "#" sem aspas como início de
# comentário, mesmo no MEIO da linha. Não deve ser um problema aqui (só IP/porta/números),
# mas se algum valor futuro tiver caracteres especiais, envolva em aspas duplas.

Plant__Simulate=false
Plant__Host=SUBSTITUA_PELO_IP_REAL_DO_CLP
Plant__Port=502
Plant__UnitId=1
Plant__PollingIntervalMs=3000
Plant__SwapRealWords=false
